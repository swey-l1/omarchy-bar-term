#!/usr/bin/env bash
# The session layer behind the Bar Terminal bar widget. Each tab is a tmux
# session, so the shell behind it is a real one: `cd` sticks, the environment
# stays, a command that asks a question can be answered, and the session
# outlives the widget -- the shell can restart, or you can attach to the same
# session in a terminal and carry on where the pad left off.
#
#   bar-term status              "up" / "notool"
#   bar-term ensure <n>          make session <n> exist, print its name
#   bar-term send <n> <cmd...>   type a command into it and press Enter
#   bar-term capture <n> [lines] print what its screen says
#   bar-term states [count]      one line per session: "<n> idle|running|gone <exit>"
#   bar-term interrupt <n>       Ctrl+C into it
#   bar-term reset <n>           clear its screen and scrollback
#   bar-term restart <n>         kill it and make a fresh one
#   bar-term attach <n>          open a terminal attached to it
#
# The widget shells out here for all of it, so everything it can do can be done
# by hand from a terminal, and tested without a compositor (test/bar-term.sh).
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

TMUX_BIN="${BAR_TERM_TMUX:-tmux}"
# Where a new session starts. The widget passes its setting; by hand you get
# $HOME, which is where a terminal would have opened.
WORKDIR="${WORKDIR:-$HOME}"
# The session's width in columns. It decides where lines wrap, so it wants to
# match what the pad can show rather than a terminal's idea of a screen.
COLS="${COLS:-72}"
ROWS="${ROWS:-40}"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/bar-term"

name_for() { echo "bar-term-$1"; }
rc_file()  { echo "$STATE_DIR/$1.rc"; }

need_n() { [ -n "${1:-}" ] && [ "$1" -ge 1 ] 2>/dev/null || { echo "bar-term: need a session number" >&2; exit 2; }; }

usage() {
  echo "usage: bar-term {status|ensure|send|capture|states|interrupt|reset|restart|attach} …" >&2
  exit 2
}

have_tmux() { command -v "$TMUX_BIN" >/dev/null 2>&1; }

# Idempotent: called before anything that needs the session to be there, so the
# widget never has to care whether this is the first command of the session or
# the hundredth.
ensure() {
  local n=$1 s; s=$(name_for "$n")
  "$TMUX_BIN" has-session -t "=$s" 2>/dev/null && { echo "$s"; return 0; }
  mkdir -p "$STATE_DIR"
  # A login-ish interactive bash with our rc file, which sources the user's own
  # and adds nothing they can see. -c is where it starts.
  BAR_TERM_RC_FILE=$(rc_file "$n") \
    "$TMUX_BIN" new-session -d -s "$s" -c "$WORKDIR" -x "$COLS" -y "$ROWS" \
      "BAR_TERM_RC_FILE=$(printf %q "$(rc_file "$n")") exec bash --rcfile $(printf %q "$here/session-rc.bash") -i"
  echo "$s"
}

case "${1:-}" in
  status)
    have_tmux && echo up || echo notool
    ;;

  ensure)
    need_n "${2:-}"; have_tmux || exit 127
    ensure "$2"
    ;;

  send)
    need_n "${2:-}"; have_tmux || exit 127
    n=$2; shift 2; [ $# -gt 0 ] || usage
    ensure "$n" >/dev/null
    # -l would send it literally, without Enter; two calls keep the command and
    # the Return separate so a command containing "Enter" is not misread.
    "$TMUX_BIN" send-keys -t "$(name_for "$n")" -l -- "$*"
    "$TMUX_BIN" send-keys -t "$(name_for "$n")" Enter
    ;;

  capture)
    need_n "${2:-}"; have_tmux || exit 127
    lines=${3:-200}
    # -J joins wrapped lines back together, -S -N reaches into the scrollback.
    # A session that is gone prints nothing rather than failing: the pad shows
    # an empty screen, and the next send brings it back.
    # Trailing blanks are the rest of the pane's height, not output, and they
    # would push the real text off the top of a pad that scrolls to the end.
    "$TMUX_BIN" capture-pane -p -J -t "$(name_for "$2")" -S "-$lines" 2>/dev/null \
      | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'
    ;;

  states)
    have_tmux || { echo "notool"; exit 0; }
    count=${2:-4}
    # One call for every tab rather than one per tab: this runs on a timer, and
    # four processes a tick to draw four dots is not a reasonable price.
    live=$("$TMUX_BIN" list-sessions -F '#{session_name} #{pane_current_command}' 2>/dev/null)
    for n in $(seq 1 "$count"); do
      s=$(name_for "$n")
      line=$(printf '%s\n' "$live" | grep -m1 "^$s ")
      if [ -z "$line" ]; then
        echo "$n gone -"
        continue
      fi
      cmd=${line#"$s" }
      rc=$(cat "$(rc_file "$n")" 2>/dev/null); rc=${rc:--}
      # The pane's foreground command is the shell itself exactly when nothing
      # is running in it, which is the only "busy" signal a session gives.
      case "$cmd" in
        bash|sh|zsh|fish|-bash) echo "$n idle $rc" ;;
        *)                      echo "$n running $rc" ;;
      esac
    done
    ;;

  interrupt)
    need_n "${2:-}"; have_tmux || exit 127
    "$TMUX_BIN" send-keys -t "$(name_for "$2")" C-c
    ;;

  reset)
    need_n "${2:-}"; have_tmux || exit 127
    s=$(name_for "$2")
    "$TMUX_BIN" clear-history -t "$s" 2>/dev/null
    # clear-history empties the scrollback; the screen still shows what it
    # showed, so the shell is asked to redraw an empty one.
    "$TMUX_BIN" send-keys -t "$s" -l -- "clear"
    "$TMUX_BIN" send-keys -t "$s" Enter
    ;;

  restart)
    need_n "${2:-}"; have_tmux || exit 127
    "$TMUX_BIN" kill-session -t "=$(name_for "$2")" 2>/dev/null
    rm -f "$(rc_file "$2")"
    ensure "$2"
    ;;

  attach)
    need_n "${2:-}"; have_tmux || exit 127
    command -v omarchy-launch-terminal >/dev/null 2>&1 || {
      echo "bar-term: omarchy-launch-terminal not found" >&2; exit 127; }
    ensure "$2" >/dev/null
    # The same session, not a new shell: attaching is the point, so whatever is
    # on the pad's screen is what the terminal opens showing.
    omarchy-launch-terminal "$TMUX_BIN" attach -t "=$(name_for "$2")"
    ;;

  *) usage ;;
esac
