#!/usr/bin/env bash
# The command runner behind the Bar Terminal bar widget. The widget shells out
# here; this script owns running the command, bounding it, and handing it off to
# a real terminal, so it is usable from a terminal without the shell running and
# testable alone (test/bar-term.sh).
#
#   bar-term status              "up" / "notool"
#   bar-term run <command...>    run it, stream stdout and stderr, exit with its status
#   bar-term open <command...>   hand it to a real terminal that outlives the pad
#
# The shell is not looked up through PATH under a name the test could shadow: it
# is $BAR_TERM_SHELL, so a test can point one invocation at a fake without
# rewriting PATH for the coreutils this script itself runs.
set -uo pipefail

SHELL_BIN="${BAR_TERM_SHELL:-/bin/bash}"
# Where commands run. The widget passes its configured directory; a bare shell
# invocation gets $HOME, which is what a terminal would have opened in.
WORKDIR="${WORKDIR:-$HOME}"
# A command that never returns would otherwise hold the pad's process open for
# the rest of the session. 124 is what timeout reports, and the widget says so.
TIMEOUT="${TIMEOUT:-20}"
# The pad shows a few dozen lines; a runaway `yes` should not be allowed to fill
# memory on the way to being thrown away.
MAXBYTES="${MAXBYTES:-65536}"

usage() { echo "usage: bar-term {status|run <command...>|open <command...>}" >&2; exit 2; }

case "${1:-}" in
  status)
    # The shell is the only thing `run` needs; the terminal launcher matters
    # only to `open`, so its absence is not the widget's normal state.
    [ -x "$SHELL_BIN" ] && echo up || echo notool
    ;;

  run)
    shift; [ $# -gt 0 ] || usage
    cd "$WORKDIR" 2>/dev/null || { echo "bar-term: cannot enter $WORKDIR" >&2; exit 2; }

    # Everything the command starts has to be stoppable, both when the widget
    # says stop and when it runs too long. Both are the same act -- take down the
    # whole process group -- so the command runs as a background job with job
    # control on, which gives it a group of its own, and a watchdog does the
    # timing out rather than timeout(1). timeout was the first attempt and it
    # puts *itself* in a new group, so terminating this script left it, and the
    # command under it, running with nothing able to reach them.
    set -m
    rc_file=$(mktemp); to_flag=$(mktemp -u)
    # -l so the command sees the PATH a terminal would give it; 2>&1 because the
    # pad has one output pane and interleaved is the order things happened in.
    # head bounds the output and closes the pipe, which stops the producer too.
    { "$SHELL_BIN" -lc "$*" 2>&1; echo $? >"$rc_file"; } | head -c "$MAXBYTES" &
    job=$!
    pgid=$(ps -o pgid= -p "$job" 2>/dev/null | tr -d ' ')
    stop() { [ -n "${pgid:-}" ] && kill -TERM -"$pgid" 2>/dev/null; }
    # The watchdog is a group leader in its own right, so it is taken down as a
    # group too: killing just the subshell would leave the sleep inside it, and
    # an orphaned sleep per stopped command adds up over a session.
    unwatch() { [ -n "${watchdog:-}" ] && kill -TERM -"$watchdog" 2>/dev/null; }
    # 143 is what a process terminated by SIGTERM reports, which is what this
    # became; the widget reads it as stopped rather than as the command's verdict.
    trap 'stop; unwatch; rm -f "$rc_file" "$to_flag"; exit 143' TERM INT HUP

    # Its own group (job control again), so stopping the command does not stop
    # the thing that is timing it.
    ( sleep "$TIMEOUT"; : >"$to_flag"; stop ) &
    watchdog=$!

    wait "$job" 2>/dev/null
    unwatch; wait "$watchdog" 2>/dev/null

    if [ -e "$to_flag" ]; then rm -f "$to_flag" "$rc_file"; exit 124; fi
    rc=$(cat "$rc_file" 2>/dev/null); rm -f "$rc_file"
    exit "${rc:-1}"
    ;;

  open)
    shift; [ $# -gt 0 ] || usage
    command -v omarchy-launch-terminal >/dev/null 2>&1 || {
      echo "bar-term: omarchy-launch-terminal not found" >&2; exit 127; }
    # `exec bash -l` at the end keeps the window up afterwards: the point of
    # handing off is to read or carry on with what the command left behind.
    omarchy-launch-terminal bash -lc "cd $(printf %q "$WORKDIR"); $*; exec bash -l"
    ;;

  *) usage ;;
esac
