#!/usr/bin/env bash
# The session layer behind the Bar Terminal bar widget. Each tab is a tmux
# session, so the shell behind it is a real one: `cd` sticks, the environment
# stays, a command that asks a question can be answered, and the session
# outlives the widget -- the shell can restart, or you can attach to the same
# session in a terminal and carry on where the pad left off.
#
#   bar-term status                 "up" / "notool"
#   bar-term list                   every session on the server: "<name>\t<cwd>"
#   bar-term ensure <name>          make that session exist, print its name
#   bar-term send <name> <cmd...>   type a command into it and press Enter
#   bar-term type <name> <text>     type text into it, no Enter
#   bar-term key <name> <key>...    press named keys in it: Enter, Tab, C-c, Up
#   bar-term capture <name> [lines] print what its screen says
#   bar-term size <name> <c> <r>    make the session that many columns and rows
#   bar-term states <name>...       a line per name, in order: "<i> idle|running|gone <exit> <cwd>"
#   bar-term interrupt <name>       Ctrl+C into it
#   bar-term reset <name>           clear its screen and scrollback
#   bar-term restart <name>         kill it and make a fresh one
#   bar-term attach <name>          open a terminal attached to it
#
# Verbs take a session *name*, not a tab number, because a tab can be pointed at
# any session on the server -- one you made yourself in a terminal, not only the
# bar-term-<n> ones this script creates.
#
# The widget shells out here for all of it, so everything it can do can be done
# by hand from a terminal, and tested without a compositor (test/bar-term.sh).
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

TMUX_BIN="${BAR_TERM_TMUX:-tmux}"
# Where a new session starts. The widget passes its setting; by hand you get
# $HOME, which is where a terminal would have opened.
WORKDIR="${WORKDIR:-$HOME}"
# The session's width in columns. It decides where lines wrap, so it wants to
# match what the pad can show rather than a terminal's idea of a screen.
COLS="${COLS:-72}"
ROWS="${ROWS:-40}"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/bar-term"

# The exit-status file is named after the session, so it has to survive whatever
# characters a session name is allowed to have.
rc_file() { echo "$STATE_DIR/$(printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_').rc"; }

need_name() { [ -n "${1:-}" ] || { echo "bar-term: need a session name" >&2; exit 2; }; }

usage() {
  echo "usage: bar-term {status|list|ensure|send|capture|states|interrupt|reset|restart|attach} …" >&2
  exit 2
}

have_tmux() { command -v "$TMUX_BIN" >/dev/null 2>&1; }

# Idempotent: called before anything that needs the session to be there, so the
# widget never has to care whether this is the first command of the session or
# the hundredth.
ensure() {
  local s=$1
  "$TMUX_BIN" has-session -t "=$s" 2>/dev/null && { echo "$s"; return 0; }
  mkdir -p "$STATE_DIR"
  # A login-ish interactive bash with our rc file, which sources the user's own
  # and adds nothing they can see. -c is where it starts.
  "$TMUX_BIN" new-session -d -s "$s" -c "$WORKDIR" -x "$COLS" -y "$ROWS" \
    "BAR_TERM_RC_FILE=$(printf %q "$(rc_file "$s")") exec bash --rcfile $(printf %q "$here/session-rc.bash") -i"
  # Wait for the shell to have drawn its prompt before anyone types into it.
  # Keys sent to a pty whose shell has not read them yet are echoed raw and then
  # read back as input, so the first command of a session appeared twice: once
  # as bare text at the top of the screen, once properly at a prompt.
  #
  # The signal is the prompt itself. #{pane_current_command} is no use here: it
  # says "bash" from the moment the pane exists, which is before bash has run
  # anyone's rc files or printed anything.
  for _ in $(seq 1 40); do
    [ -n "$("$TMUX_BIN" capture-pane -p -t "$s" 2>/dev/null | tr -d '[:space:]')" ] && break
    sleep 0.05
  done
  echo "$s"
}

case "${1:-}" in
  status)
    have_tmux && echo up || echo notool
    ;;

  list)
    have_tmux || exit 127
    # Every session on the server, whoever made it: a tab can be pointed at any
    # of them. Tab-separated because a session name may contain spaces.
    "$TMUX_BIN" list-sessions -F '#{session_name}	#{pane_current_path}' 2>/dev/null
    ;;

  ensure)
    need_name "${2:-}"; have_tmux || exit 127
    ensure "$2"
    ;;

  send)
    need_name "${2:-}"; have_tmux || exit 127
    s=$2; shift 2; [ $# -gt 0 ] || usage
    ensure "$s" >/dev/null
    # -l sends it literally, without interpreting key names; Enter goes
    # separately so a command containing the word "Enter" is not misread.
    "$TMUX_BIN" send-keys -t "$s" -l -- "$*"
    "$TMUX_BIN" send-keys -t "$s" Enter
    ;;

  type)
    need_name "${2:-}"; have_tmux || exit 127
    s=$2; shift 2; [ $# -gt 0 ] || usage
    ensure "$s" >/dev/null
    # -l is literal: no key name in the text is interpreted, so a command
    # containing the word "Enter" types the word.
    "$TMUX_BIN" send-keys -t "$s" -l -- "$*"
    ;;

  key)
    need_name "${2:-}"; have_tmux || exit 127
    s=$2; shift 2; [ $# -gt 0 ] || usage
    ensure "$s" >/dev/null
    # Named keys, the other half of `type`: Enter, Tab, BSpace, Up, C-c, C-r.
    # Whatever tmux understands, which is what the shell will see.
    "$TMUX_BIN" send-keys -t "$s" -- "$@"
    ;;

  size)
    need_name "${2:-}"; have_tmux || exit 127
    [ -n "${3:-}" ] && [ -n "${4:-}" ] || usage
    ensure "$2" >/dev/null
    # The pad shows a fixed number of columns, and a session wider than that
    # wraps every full-width line into a ragged remnant underneath it -- which
    # is what a TUI's boxes and rules turn into. Sizing the session to the pad
    # is the difference between reading a program and squinting at it.
    #
    # This sets window-size to manual, so an attached terminal no longer
    # resizes it; `attach` hands that back before opening one.
    "$TMUX_BIN" resize-window -t "$2" -x "$3" -y "$4" 2>/dev/null
    ;;

  capture)
    need_name "${2:-}"; have_tmux || exit 127
    lines=${3:-200}
    # -J joins wrapped lines back together, -S -N reaches into the scrollback.
    # A session that is gone prints nothing rather than failing: the pad shows
    # an empty screen, and the next command brings it back.
    #
    # Trailing blanks are the rest of the pane's height, not output, and they
    # would push the real text off the top of a pad that scrolls to the end.
    # Two seds, not one with two scripts: the blank-run trim uses N to look at
    # the next line, and a line pulled in that way never sees an earlier -e.
    # Trailing spaces are the rest of the pane's width, and the pad draws its
    # caret on the end of the last line: leave them and the caret floats out in
    # the middle of nowhere.
    "$TMUX_BIN" capture-pane -p -J -t "$2" -S "-$lines" 2>/dev/null \
      | sed 's/[[:space:]]*$//' \
      | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'
    ;;

  states)
    have_tmux || { echo "notool"; exit 0; }
    shift; [ $# -gt 0 ] || usage
    # One call for every tab rather than one per tab: this runs on a timer, and
    # four processes a tick to draw four dots is not a reasonable price.
    live=$("$TMUX_BIN" list-sessions -F '#{session_name}	#{pane_current_command}	#{pane_current_path}' 2>/dev/null)
    i=0
    for s in "$@"; do
      i=$((i+1))
      line=$(printf '%s\n' "$live" | grep -m1 -F "$(printf '%s\t' "$s")")
      if [ -z "$line" ]; then
        echo "$i gone - -"
        continue
      fi
      rest=${line#*$'\t'}
      cmd=${rest%%$'\t'*}
      path=${rest#*$'\t'}
      rc=$(cat "$(rc_file "$s")" 2>/dev/null); rc=${rc:--}
      # The pane's foreground command is the shell itself exactly when nothing
      # is running in it, which is the only "busy" signal a session gives.
      case "$cmd" in
        bash|sh|zsh|fish|-bash) echo "$i idle $rc $path" ;;
        *)                      echo "$i running $rc $path" ;;
      esac
    done
    ;;

  interrupt)
    need_name "${2:-}"; have_tmux || exit 127
    "$TMUX_BIN" send-keys -t "$2" C-c
    ;;

  reset)
    need_name "${2:-}"; have_tmux || exit 127
    "$TMUX_BIN" clear-history -t "$2" 2>/dev/null
    # clear-history empties the scrollback; the screen still shows what it
    # showed, so the shell is asked to redraw an empty one.
    "$TMUX_BIN" send-keys -t "$2" -l -- "clear"
    "$TMUX_BIN" send-keys -t "$2" Enter
    ;;

  restart)
    need_name "${2:-}"; have_tmux || exit 127
    "$TMUX_BIN" kill-session -t "=$2" 2>/dev/null
    rm -f "$(rc_file "$2")"
    ensure "$2"
    ;;

  attach)
    need_name "${2:-}"; have_tmux || exit 127
    command -v omarchy-launch-terminal >/dev/null 2>&1 || {
      echo "bar-term: omarchy-launch-terminal not found" >&2; exit 127; }
    ensure "$2" >/dev/null
    # Give sizing back to whatever attaches: the pad sized this window to its
    # own width, and a terminal should not inherit a window narrower than it is.
    # The pad sets it again next time it looks.
    "$TMUX_BIN" set-window-option -t "$2" window-size latest >/dev/null 2>&1
    # The same session, not a new shell: attaching is the point, so whatever is
    # on the pad's screen is what the terminal opens showing.
    omarchy-launch-terminal "$TMUX_BIN" attach -t "=$2"
    ;;

  *) usage ;;
esac
