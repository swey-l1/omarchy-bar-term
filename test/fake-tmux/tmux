#!/bin/bash
# A stand-in for tmux, for test/bar-term.sh. Logs every call to $FAKE_LOG, one
# per line, and answers the few questions the shim asks:
#
#   FAKE_SESSIONS   one session per line, tab-separated: name, current command,
#                   current path. Rendered to whichever fields the caller's -F
#                   asks for, which is what makes `list` and `states` differ.
#   FAKE_CAPTURE    what capture-pane prints
#
# Reached through $BAR_TERM_TMUX rather than PATH: the shim runs coreutils of
# its own, and a fake at the front of PATH would stand in for those too.
printf '%s\n' "$*" >> "${FAKE_LOG:?}"

case "$1" in
  kill-session)
    # Remembered, so a session really is gone afterwards: without this a test
    # for "restart" would see the killed session still answering has-session
    # and never reach the part that builds a new one.
    printf '%s\n' "${3#=}" >> "$FAKE_LOG.killed"
    ;;
  has-session)
    s=${3#=}
    grep -qx "$s" "$FAKE_LOG.killed" 2>/dev/null && exit 1
    # A real tab, built with printf: grep does not read "\t" as one, it reads it
    # as the letter t, so "^name\t" quietly matched nothing and every session
    # looked absent.
    tab=$(printf '\t')
    printf '%s\n' "${FAKE_SESSIONS:-}" | grep -q "^$s$tab" && exit 0 || exit 1
    ;;
  list-sessions)
    [ -z "${FAKE_SESSIONS:-}" ] && exit 0
    case "$*" in
      *pane_current_command*) printf '%s\n' "$FAKE_SESSIONS" ;;        # name, command, mouse, path
      *) printf '%s\n' "$FAKE_SESSIONS" | cut -f1,4 ;;                 # name, path
    esac
    ;;
  display-message)
    # The shim asks about one pane at a time: the mouse flag, and the size it
    # should aim a wheel at.
    case "$*" in
      *mouse_any_flag*) printf '%s\n' "${FAKE_MOUSE:-0}" ;;
      *pane_width*)     printf '80\n' ;;
      *pane_height*)    printf '24\n' ;;
      *)                printf '\n' ;;
    esac
    ;;
  capture-pane)  printf '%s' "${FAKE_CAPTURE:-}" ;;
esac
exit 0
